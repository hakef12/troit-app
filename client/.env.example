# Client ID de Google OAuth (ver README para como generarlo). Debe ser IDENTICO
# al GOOGLE_CLIENT_ID de mas abajo. Sin esto, el boton de Google no aparece.
VITE_GOOGLE_CLIENT_ID=

# --- Variables del backend (api/), usadas solo por node api/_dev-server.js local ---
# (en Vercel se configuran en el dashboard del proyecto, no en este archivo)
PORT=4000
JWT_SECRET=cambia_este_secreto_en_produccion

# Supabase (Postgres + almacenamiento de imagenes). Ver README para como
# generarlos desde tu proyecto de Supabase (Connect > Session pooler, y
# Settings > API Keys).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Numero de WhatsApp del restaurante en formato internacional sin + ni espacios (ej: pais+numero)
WHATSAPP_NUMBER=593985206063
# Cuantos dolares hay que gastar para ganar 1 punto (precios del local en USD)
POINTS_PER_UNIT=1

# Ubicacion del local, usada para la opcion de retiro en el mapa
RESTAURANT_NAME=Troit
RESTAURANT_ADDRESS=Autopista Narcisa de Jesús, Sauces, Guayaquil, Ecuador
RESTAURANT_LAT=-2.126601
RESTAURANT_LNG=-79.882728

GOOGLE_CLIENT_ID=

# Clave de OpenRouteService (gratis, ver openrouteservice.org) para calcular la
# distancia REAL en carretera del envio (no en linea recta). Sin esto, cae a la
# distancia en linea recta como resguardo.
ORS_API_KEY=

# Credenciales del usuario admin que se crea la primera vez que arranca el server
# (solo si la tabla de usuarios esta vacia). Cambialas antes de publicar.
ADMIN_EMAIL=admin@restaurante.com
ADMIN_PASSWORD=admin123
